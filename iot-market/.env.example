# Copy to .env and fill in your own values. Never commit real keys.
# The local Hardhat network (npx hardhat node) needs none of these.
# Optional: fiat prices in the gas report.
COINMARKETCAP_API_KEY=
# For Sepolia deploys and Etherscan verification (CI reads them from
# GitHub Secrets).
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
SEPOLIA_USER_0=YOUR_SEPOLIA_PRIVATE_KEY_0
SEPOLIA_USER_1=YOUR_SEPOLIA_PRIVATE_KEY_1
SEPOLIA_USER_2=YOUR_SEPOLIA_PRIVATE_KEY_2
