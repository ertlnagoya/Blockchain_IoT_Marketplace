# iot-market-ui environment template
# Copy this file to `.env.local` and adjust the host to match your setup.
#   cp .env.example .env.local
#
# Same-PC (default): keep 127.0.0.1.
# Phone / LAN access (mobile-viewer hands-on): replace 127.0.0.1 with the
#   PC's LAN IP (e.g. http://192.168.1.20:8545) and start the Hardhat node
#   with `npx hardhat node --hostname 0.0.0.0` so the phone can reach it.

# Local Hardhat JSON-RPC endpoint (chainId 31337). Must match the running node.
VITE_RPC_URL=http://127.0.0.1:8545

# Publisher / simple-storage endpoint used by the seller / purchased pages.
VITE_PUBLISHER_URL=http://127.0.0.1:8080
