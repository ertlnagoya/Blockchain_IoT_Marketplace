# Copy this file to .env.local before using an actual OpenAI-compatible API.
# Example:
#   cp .env.local.example .env.local
#   source .env.local

export ASSISTANT_PLANNER_MODE=llm
export ASSISTANT_PLANNER_NAME=llm-planner-openai-compatible-v1
export ASSISTANT_LLM_PROVIDER=openai_compatible
export ASSISTANT_LLM_API_BASE_URL=https://api.openai.com/v1
export ASSISTANT_LLM_API_KEY=REPLACE_WITH_YOUR_API_KEY
export ASSISTANT_LLM_MODEL=gpt-4.1-mini
export ASSISTANT_LLM_TIMEOUT_SECONDS=20
