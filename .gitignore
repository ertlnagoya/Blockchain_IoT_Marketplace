# macOS
.DS_Store

# hardhat/build
ssi/artifacts/
ssi/cache/

# node
ssi/node_modules/
ssi/ssi-ui/node_modules/

# frontend build
ssi/ssi-ui/dist/
ssi/ssi-ui/.vite/
ssi/ssi-ui/.next/

# 不提交 provider
ssi/did/provider/
ssi/vc/provider/
ssi/contracts/*Provider*.sol
ssi/contracts/scripts/*provider*.cjs
ssi/ssi-ui/src/components/*provider*.jsx

# ZK 中间产物（不入库）
ssi/circuits/*.wtns
ssi/circuits/*.ptau
ssi/circuits/*_000*.zkey
ssi/circuits/*.r1cs

# docs build output
site/

# Python cache
__pycache__/
*.pyc
.venv-ssi/

# Stage T (case B): default media gateway store dir
publisher/data/

# Stage T (case B) — provider_with_media.py auto-generates these
# 1×1 fixture blobs at runtime; no need to track them.
examples/hands_on/data_user_vc_tiered/fixtures/

# Local-dev only — host IP / RPC URL are operator-specific.
infra/.env

# Home Assistant demo runtime state (the container writes into the
# mounted config dir); only the three hand-written files are tracked.
home-assistant-demo/config/*
!home-assistant-demo/config/configuration.yaml
!home-assistant-demo/config/automations.yaml
!home-assistant-demo/config/scripts.yaml

# Local LLM configuration (Phase 3 assistant-llm profile)
.env.local
